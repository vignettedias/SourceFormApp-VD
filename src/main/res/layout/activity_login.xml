<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#0B0B0F"

    android:fillViewport="true">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="24dp"

        android:gravity="center_horizontal">

        <!-- APP TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="SourceForm"

            android:textColor="#FFFFFF"

            android:textStyle="bold"

            android:textSize="38sp"

            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Secure Cloud Intake System"

            android:textColor="#9CA3AF"

            android:textSize="15sp"

            android:layout_marginTop="6dp"/>

        <!-- SECURITY BADGE -->

        <TextView
            android:id="@+id/tvSecurityBadge"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="🔒 Enterprise Security Enabled"

            android:textColor="#22C55E"

            android:textStyle="bold"

            android:textSize="14sp"

            android:layout_marginTop="18dp"/>

        <!-- SECURITY FEATURES CARD -->

        <androidx.cardview.widget.CardView

            android:id="@+id/cardSecurityFeatures"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            app:cardCornerRadius="24dp"

            app:cardElevation="12dp"

            app:cardBackgroundColor="#161B22">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Security Features"

                    android:textColor="#FFFFFF"

                    android:textStyle="bold"

                    android:textSize="20sp"

                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvFeatureAuth"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="✓ Firebase Authentication"

                    android:textColor="#22C55E"

                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvFeatureEncrypt"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="✓ Metadata Encryption"

                    android:textColor="#22C55E"

                    android:textSize="14sp"

                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvFeatureHash"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="✓ SHA-256 Integrity Verification"

                    android:textColor="#22C55E"

                    android:textSize="14sp"

                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvFeatureStorage"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="✓ Protected Cloud Storage"

                    android:textColor="#22C55E"

                    android:textSize="14sp"

                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvFeatureAudit"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="✓ Security Audit Logging"

                    android:textColor="#22C55E"

                    android:textSize="14sp"

                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- AUTH SECTION -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Authentication"

            android:textColor="#FFFFFF"

            android:textStyle="bold"

            android:textSize="20sp"

            android:layout_marginTop="28dp"

            android:layout_marginBottom="18dp"/>

        <!-- GOOGLE -->

        <Button
            android:id="@+id/btnGoogle"

            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:text="Continue with Google"

            android:textColor="#FFFFFF"

            android:textStyle="bold"

            android:textAllCaps="false"

            android:backgroundTint="#22C55E"/>

        <!-- GITHUB -->

        <Button
            android:id="@+id/btnGithub"

            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:layout_marginTop="14dp"

            android:text="Continue with GitHub"

            android:textColor="#FFFFFF"

            android:textStyle="bold"

            android:textAllCaps="false"

            android:backgroundTint="#374151"/>

        <!-- FACEBOOK -->

        <Button
            android:id="@+id/btnFacebook"

            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:layout_marginTop="14dp"

            android:text="Continue with Facebook"

            android:textColor="#FFFFFF"

            android:textStyle="bold"

            android:textAllCaps="false"

            android:backgroundTint="#2563EB"/>

        <!-- FOOTER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Distributed Mobile Intake Platform"

            android:textColor="#9CA3AF"

            android:textStyle="bold"

            android:textSize="13sp"

            android:layout_marginTop="36dp"/>

        <TextView
            android:id="@+id/tvFooterDescription"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="All user information is protected through encryption, integrity verification and secure cloud storage."

            android:textAlignment="center"

            android:textColor="#9CA3AF"

            android:textSize="12sp"

            android:layout_marginTop="10dp"

            android:layout_marginBottom="30dp"/>

    </LinearLayout>

</ScrollView>
